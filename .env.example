# RepoMind Environment Configuration Example
# Copy this file to .env and configure as needed.

# LLM Providers (Optional - Demo mode works out-of-the-box without keys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub API (Optional - for high-rate limit repository cloning)
GITHUB_TOKEN=

# Vector Database (Default: :memory: in-process Qdrant)
QDRANT_URL=:memory:
QDRANT_API_KEY=

# Application Mode
DEBUG=true
DEMO_MODE=true
