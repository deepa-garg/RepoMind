# ==============================================================================
# RepoMind - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure as needed.
# Secrets must be kept exclusively in the backend environment.
# Never commit real API keys or credentials to source control.

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration
# ------------------------------------------------------------------------------
# If no external API key is supplied, RepoMind runs in Grounded Retrieval-Only Mode
# (using AST code intelligence, symbol resolution, and retrieved evidence).
# To enable generative responses, provide one of the following keys:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. GitHub Access & Rate Limiting
# ------------------------------------------------------------------------------
# Optional GitHub Personal Access Token (classic or fine-grained).
# Providing a token increases the GitHub API rate limit from 60 to 5,000 req/hr
# and allows cloning/fetching private repositories if granted read access.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# ------------------------------------------------------------------------------
# 3. Vector Database (Qdrant)
# ------------------------------------------------------------------------------
# Leave QDRANT_URL blank to use the default persistent local disk storage
# located at backend/data/qdrant.
# To connect to a remote or containerized Qdrant instance, provide:
# QDRANT_URL=http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=repomind_code

# ------------------------------------------------------------------------------
# 4. Embedding Model & Retrieval Settings
# ------------------------------------------------------------------------------
# Default lightweight sentence-transformer model (384 dimensions)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Reciprocal Rank Fusion constant and retrieval top-k count
RRF_K=60
TOP_K_RETRIEVAL=8
MAX_CHUNK_LINES=100
CHUNK_OVERLAP_LINES=15

# ------------------------------------------------------------------------------
# 5. Ingestion, Timeouts, and Resource Safety Limits
# ------------------------------------------------------------------------------
MAX_REPO_SIZE_MB=100
MAX_FILE_SIZE_BYTES=1048576
MAX_FILES_PER_REPO=2000
GIT_TIMEOUT_SECONDS=45

# ------------------------------------------------------------------------------
# 6. Application Metadata & Debug Flags
# ------------------------------------------------------------------------------
DEBUG=true
DEMO_MODE=true
